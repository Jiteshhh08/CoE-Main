# Hackathon Hub — self-hosted renderer + search (Firecrawl).
# Optional: leaving these unset keeps the pipeline rules-and-crawl only, and
# JS-shell sources (Unstop, HackerEarth, Devfolio) stay MANUAL.
# FIRECRAWL_URL MUST be a loopback or RFC1918 host — the app refuses a public
# endpoint here so this can never become an open egress proxy.
FIRECRAWL_URL=http://127.0.0.1:3002
FIRECRAWL_API_KEY=
